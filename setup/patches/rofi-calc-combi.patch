+// dotfiles patch: in rofi's combi mode (apps + files + calc in one list) only show
+// the result row when the input looks like a calculation. qalc happily reads plain
+// words as units ("fire" -> 0), so require a digit plus an operator, parenthesis or
+// a unit conversion ("5 km to miles").
+static gboolean looks_like_math(const char* input)
+{
+    if (input == NULL || strpbrk(input, "0123456789") == NULL) {
+        return FALSE;
+    }
+    if (strpbrk(input, "+-*/^%()=!") != NULL) {
+        return TRUE;
+    }
+    return strstr(input, " to ") != NULL || strstr(input, " in ") != NULL;
+}
+
+static gboolean has_answer(const CALCModePrivateData* pd)
+{
+    return looks_like_math(pd->previous_input) && pd->last_result != NULL &&
+           *pd->last_result && !is_error_string(pd->last_result);
+}
