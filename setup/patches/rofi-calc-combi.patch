+// dotfiles patch: in combi mode rofi never calls this mode's preprocess_input, so
+// read the typed text from the view and evaluate it here, synchronously (qalc takes
+// ~60ms, and only input that looks like math is evaluated). Filtering may run on
+// worker threads, hence the lock and no main-loop callbacks.
+typedef struct RofiViewState RofiViewState;
+extern RofiViewState *rofi_view_get_active(void);
+extern const char *rofi_view_get_user_input(const RofiViewState *state);
+static GMutex combi_lock;
+
+static void evaluate_sync(CALCModePrivateData* pd, const char* input)
 {
-    return TRUE;
+    char *qalc_binary = "qalc";
+    if (find_arg(QALC_BINARY_OPTION) >= 0) {
+        find_arg_str(QALC_BINARY_OPTION, &qalc_binary);
+    }
+    const char *argv[] = { qalc_binary, "-s", "update_exchange_rates 1days",
+                           find_arg(TERSE_OPTION) > -1 ? "-t" : input,
+                           find_arg(TERSE_OPTION) > -1 ? input : NULL, NULL };
+    gchar *out = NULL;
+    g_spawn_sync(NULL, (gchar **)argv, NULL, G_SPAWN_SEARCH_PATH | G_SPAWN_STDERR_TO_DEV_NULL,
+                 NULL, NULL, &out, NULL, NULL, NULL);
+    g_free(pd->last_result);
+    pd->last_result = g_strndup(out ? out : "", out ? strcspn(out, "\n") : 0);
+    g_free(out);
+    g_free(pd->previous_input);
+    pd->previous_input = g_strdup(input);
+}
+
+static int calc_token_match(const Mode* sw, G_GNUC_UNUSED rofi_int_matcher** tokens, unsigned int index)
+{
+    if (index != 0) {
+        return TRUE;  // history rows (unused with -no-history)
+    }
+    CALCModePrivateData* pd = (CALCModePrivateData*)mode_get_private_data(sw);
+    RofiViewState *state = rofi_view_get_active();
+    const char *input = state ? rofi_view_get_user_input(state) : NULL;
+    if (!looks_like_math(input)) {
+        return FALSE;
+    }
+    g_mutex_lock(&combi_lock);
+    if (pd->previous_input == NULL || strcmp(input, pd->previous_input) != 0) {
+        evaluate_sync(pd, input);
+    }
+    gboolean ok = has_answer(pd);
+    g_mutex_unlock(&combi_lock);
+    return ok;
 }
 
