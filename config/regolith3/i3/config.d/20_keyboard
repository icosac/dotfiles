exec_always --no-startup-id bash -lc '\
  gsettings set org.gnome.desktop.input-sources sources "[('"'"'xkb'"'"', '"'"'us'"'"'), ('"'"'xkb'"'"', '"'"'it'"'"')]" && \
  gsettings set org.gnome.desktop.input-sources xkb-options "[ '"'"'grp:alt_space_toggle'"'"' ]" && \
  setxkbmap -layout "us,it" -option "grp:alt_space_toggle" \
'
# Restart the watcher in one command so the kill can't race the new instance;
# [k] keeps pkill from matching (and killing) this very shell.
exec_always --no-startup-id sh -c 'pkill -f "[k]eyboard-layout-watcher"; exec ~/.config/regolith3/i3xrocks/scripts/keyboard-layout-watcher'
